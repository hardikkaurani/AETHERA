# Server Environment Variables Template
# Copy this to .env in the server directory

# Database Connection
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/bug_tracker

# JWT Configuration
# Generate a random string for production: openssl rand -base64 64
JWT_SECRET=replace-with-a-64-plus-character-random-secret-before-production

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
# Set to your frontend URL in production
CORS_ORIGIN=http://localhost:5173

# Optional: For cloud deployments
# RENDER_API_KEY=your_render_api_key_if_needed
# DATABASE_POOL_SIZE=20
